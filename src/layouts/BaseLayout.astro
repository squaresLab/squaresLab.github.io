---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | squaresLab @ CMU</title>
    <meta name="description" content="Software Quality in Real and Evolving Systems Lab at Carnegie Mellon University" />
  </head>
  <body class="bg-white text-slate-nav font-sans">
    <slot />
  </body>
</html>
