---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationFilter from '../components/PublicationFilter.tsx';
import { getPublications } from '../lib/publications';
import { getCollection } from 'astro:content';

const publications = getPublications();
const projectEntries = await getCollection('projects');

// Build topic metadata from publications and projects
const topicCounts = new Map<string, number>();
for (const pub of publications) {
  for (const tag of pub.projects) {
    topicCounts.set(tag, (topicCounts.get(tag) || 0) + 1);
  }
}

const topics = projectEntries
  .filter((p) => topicCounts.has(p.data.tag))
  .map((p) => ({
    tag: p.data.tag,
    name: p.data.name,
    count: topicCounts.get(p.data.tag) || 0,
  }))
  .sort((a, b) => b.count - a.count);

// Extract unique years sorted descending
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications">
  <section class="bg-gradient-to-b from-gray-hero to-gray-hero-end py-10">
    <div class="max-w-content mx-auto px-8">
      <h1 class="text-3xl font-extrabold">Publications</h1>
      <p class="text-gray-secondary mt-1">{publications.length} publications</p>
    </div>
  </section>

  <PublicationFilter
    client:load
    publications={publications}
    topics={topics}
    years={years}
  />
</BaseLayout>
