---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { getPublications } from '../lib/publications';

const publications = getPublications();

// Extract unique years, sorted descending
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);

// Group publications by year
const pubsByYear = new Map<number, typeof publications>();
for (const year of years) {
  pubsByYear.set(year, publications.filter((p) => p.year === year));
}
---

<BaseLayout title="Publications">
  <section class="bg-gradient-to-b from-gray-hero to-gray-hero-end py-10">
    <div class="max-w-content mx-auto px-8">
      <h1 class="text-3xl font-extrabold">Publications</h1>
      <p class="text-gray-secondary mt-1">{publications.length} publications</p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-8 py-8">
    {years.map((year) => (
      <div class="mb-8">
        <h2 class="text-xl font-bold text-red-cmu border-b border-gray-subtle pb-1 mb-4">
          {year}
        </h2>
        {pubsByYear.get(year)!.map((pub) => (
          <PublicationEntry pub={pub} />
        ))}
      </div>
    ))}
  </section>
</BaseLayout>
