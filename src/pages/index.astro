---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPublications } from '../lib/publications';
import { getHighlights } from '../lib/highlights';

const projects = await getCollection('projects');
const sortedProjects = projects.sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)
);

const allMembers = await getCollection('team');
const currentMembers = allMembers
  .filter((m) => m.data.status === 'current')
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));

const publications = getPublications();
const recentPubs = publications.slice(0, 5);

const highlights = getHighlights(5);

/** Extract initials: first letter uppercased + first letter of each subsequent word. */
function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  return parts[0][0].toUpperCase() + parts.slice(1).map((p) => p[0]).join('');
}

/** Format a date string as YYYY-MM. */
function formatMonth(dateStr: string): string {
  const d = new Date(dateStr);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  return `${y}-${m}`;
}

const previewMembers = currentMembers.slice(0, 6);
const extraCount = currentMembers.length - previewMembers.length;
---

<BaseLayout title="Home">
  {/* Hero */}
  <section class="bg-gradient-to-br from-gray-hero to-gray-hero-end py-16">
    <div class="max-w-content mx-auto px-8 text-center">
      <img src="/img/SquaresLogo_3color_no_text.png" alt="squaresLab logo" class="w-20 h-20 mx-auto mb-4" />
      <h1 class="text-3xl md:text-4xl font-extrabold">
        squares<span class="text-red-cmu">Lab</span>
      </h1>
      <p class="text-gray-secondary mt-3 text-lg max-w-xl mx-auto">
        <strong class="text-slate-nav">S</strong>oftware <strong class="text-slate-nav">QUA</strong>lity in <strong class="text-slate-nav">R</strong>eal <strong class="text-slate-nav">E</strong>volving <strong class="text-slate-nav">S</strong>ystems<span class="text-xs align-super">*</span>
      </p>
      <p class="text-gray-secondary mt-3 text-sm max-w-lg mx-auto">
        We research automated techniques to reason about, assure, measure, and improve the quality of real, messy, ever-changing software.
      </p>
      <p class="text-gray-secondary mt-1 text-sm">
        <a href="https://www.cs.cmu.edu/" class="text-gray-secondary hover:text-red-cmu no-underline">Carnegie Mellon University, School of Computer Science</a>
      </p>
      <p class="mt-2 text-sm">
        <a href="https://github.com/squaresLab" class="text-gray-secondary hover:text-red-cmu no-underline inline-flex items-center gap-1" target="_blank" rel="noopener">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          squaresLab on GitHub
        </a>
        &nbsp;&middot;&nbsp;
        <a href="mailto:clegoues@cs.cmu.edu" class="text-gray-secondary hover:text-red-cmu no-underline">clegoues@cs.cmu.edu</a>
      </p>
      <div class="mt-6 flex justify-center gap-4 flex-wrap">
        <a
          href="/research"
          class="bg-red-cmu text-white px-5 py-2 rounded text-sm font-semibold no-underline hover:opacity-90 transition-opacity"
        >
          Our Research
        </a>
        <a
          href="/publications"
          class="border border-slate-nav text-slate-nav px-5 py-2 rounded text-sm font-semibold no-underline hover:bg-slate-nav hover:text-white transition-colors"
        >
          Publications
        </a>
      </div>
      <p class="text-xs text-gray-secondary mt-8 italic">*We apologize, sort of, for the egregious backronym.</p>
    </div>
  </section>

  {/* Research Areas */}
  <section class="border-t-2 border-red-cmu">
    <div class="max-w-content mx-auto px-8 py-10">
      <h2 class="text-xl font-bold mb-6">Research Areas</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => (
          <a
            href="/research"
            class="block border-l-[3px] border-red-cmu pl-4 no-underline group"
          >
            <p class="font-bold text-slate-nav group-hover:text-red-cmu transition-colors">
              {project.data.name}
            </p>
            <p class="text-sm text-gray-secondary mt-1">
              {project.data.shortDescription}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Team Preview */}
  <section class="bg-gray-50">
    <div class="max-w-content mx-auto px-8 py-10">
      <h2 class="text-xl font-bold mb-6">Team</h2>
      <div class="flex items-center gap-4 flex-wrap">
        {previewMembers.map((member) => (
          <div class="flex flex-col items-center gap-1">
            {member.data.photo ? (
              <img src={member.data.photo} alt={member.data.name} class="w-16 h-16 rounded-full border-2 border-red-cmu object-cover" />
            ) : (
              <div class="w-16 h-16 rounded-full border-2 border-red-cmu bg-gray-hero flex items-center justify-center text-base font-bold text-slate-nav">
                {getInitials(member.data.name)}
              </div>
            )}
            <span class="text-xs text-gray-secondary">{member.data.name.split(' ')[0]}</span>
          </div>
        ))}
        {extraCount > 0 && (
          <a
            href="/team"
            class="text-sm text-red-cmu font-semibold no-underline hover:underline ml-2"
          >
            +{extraCount} more &rarr;
          </a>
        )}
      </div>
      <a
        href="/team"
        class="inline-block mt-4 text-sm text-red-cmu font-semibold no-underline hover:underline"
      >
        View full team &rarr;
      </a>
    </div>
  </section>

  {/* Recent Publications */}
  <section>
    <div class="max-w-content mx-auto px-8 py-10">
      <h2 class="text-xl font-bold mb-6">Recent Publications</h2>
      <div class="space-y-4">
        {recentPubs.map((pub) => (
          <div class="border-b border-gray-subtle pb-3">
            {pub.venue && (
              <span class="text-xs text-red-cmu font-semibold">
                {pub.venue}
              </span>
            )}
            <p class="text-sm font-semibold text-slate-nav mt-0.5">
              {pub.title}
            </p>
            <p class="text-xs text-gray-secondary mt-0.5">
              {pub.authors.join(', ')}
            </p>
          </div>
        ))}
      </div>
      <a
        href="/publications"
        class="inline-block mt-4 text-sm text-red-cmu font-semibold no-underline hover:underline"
      >
        View all {publications.length} publications &rarr;
      </a>
    </div>
  </section>

  {/* Highlights */}
  {highlights.length > 0 && (
    <section class="bg-gray-50">
      <div class="max-w-content mx-auto px-8 py-10">
        <h2 class="text-xl font-bold mb-6">Highlights</h2>
        <div class="space-y-3">
          {highlights.map((h) => (
            <div class="flex gap-4 items-start">
              <span class="text-xs text-gray-secondary whitespace-nowrap pt-0.5">
                {formatMonth(h.date)}
              </span>
              <div>
                {h.link ? (
                  <a
                    href={h.link}
                    class="text-sm font-semibold text-slate-nav no-underline hover:text-red-cmu transition-colors"
                  >
                    {h.title}
                  </a>
                ) : (
                  <p class="text-sm font-semibold text-slate-nav">{h.title}</p>
                )}
                {h.description && (
                  <p class="text-xs text-gray-secondary mt-0.5">{h.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
