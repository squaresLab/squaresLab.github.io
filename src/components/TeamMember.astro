---
interface Props {
  name: string;
  website?: string;
  researchArea?: string;
  photo?: string;
  size?: 'large' | 'small';
}

const { name, website, researchArea, photo, size = 'small' } = Astro.props;

// Generate initials: first letter of first name + first letter of each subsequent word
// "Claire Le Goues" → "CLG", "Rijnard van Tonder" → "RvT", "Aidan Yang" → "AY"
const parts = name.trim().split(/\s+/);
const initials = parts[0][0].toUpperCase() + parts.slice(1).map((p) => p[0]).join('');

const isLarge = size === 'large';
const avatarSize = isLarge ? 'w-24 h-24 text-2xl' : 'w-16 h-16 text-base';
---

{isLarge ? (
  <div class="flex items-center gap-4 py-3">
    {photo ? (
      <img src={photo} alt={name} class={`${avatarSize} rounded-full ring-2 ring-red-cmu object-cover shrink-0`} />
    ) : (
      <div class={`${avatarSize} rounded-full bg-gray-200 ring-2 ring-red-cmu flex items-center justify-center font-bold text-gray-secondary shrink-0`}>
        {initials}
      </div>
    )}
    <div>
      {website ? (
        <a href={website} class="text-slate-nav hover:text-red-cmu font-semibold no-underline" target="_blank" rel="noopener noreferrer">
          {name}
        </a>
      ) : (
        <span class="font-semibold text-slate-nav">{name}</span>
      )}
      {researchArea && (
        <p class="text-gray-secondary text-sm mt-0.5">{researchArea}</p>
      )}
    </div>
  </div>
) : (
  <div class="bg-white rounded-lg p-4 flex items-center gap-3">
    {photo ? (
      <img src={photo} alt={name} class={`${avatarSize} rounded-full ring-2 ring-red-cmu object-cover shrink-0`} />
    ) : (
      <div class={`${avatarSize} rounded-full bg-gray-200 ring-2 ring-red-cmu flex items-center justify-center font-bold text-gray-secondary shrink-0`}>
        {initials}
      </div>
    )}
    <div>
      {website ? (
        <a href={website} class="text-slate-nav hover:text-red-cmu font-semibold no-underline text-sm" target="_blank" rel="noopener noreferrer">
          {name}
        </a>
      ) : (
        <span class="font-semibold text-slate-nav text-sm">{name}</span>
      )}
      {researchArea && (
        <p class="text-gray-secondary text-xs mt-0.5">{researchArea}</p>
      )}
    </div>
  </div>
)}
