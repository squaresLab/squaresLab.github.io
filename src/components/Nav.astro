---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/team', label: 'Team' },
];
---

<nav class="bg-slate-nav border-b-[3px] border-red-cmu">
  <div class="max-w-content mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="text-white font-extrabold text-lg no-underline">
      squares<span class="text-red-cmu">Lab</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-6">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'text-sm font-bold no-underline transition-colors',
            currentPath.startsWith(href) ? 'text-red-cmu' : 'text-gray-300 hover:text-red-cmu',
          ]}
        >
          {label}
        </a>
      ))}
      <a href="https://github.com/squaresLab" class="text-gray-300 hover:text-red-cmu transition-colors" target="_blank" rel="noopener" aria-label="squaresLab on GitHub">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-white"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-slate-nav px-4 pb-4">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'block py-2 text-sm font-bold no-underline',
          currentPath.startsWith(href) ? 'text-red-cmu' : 'text-gray-300',
        ]}
      >
        {label}
      </a>
    ))}
    <a href="https://github.com/squaresLab" class="block py-2 text-sm font-bold no-underline text-gray-300 hover:text-red-cmu" target="_blank" rel="noopener">
      GitHub
    </a>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
